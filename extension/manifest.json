{
	"manifest_version": 3,
	"name": "Vitamine",
	"version": "0.1.0",
	"key": "",
	"description": "Lets your AI agent drive this browser through the local Vitamine server.",
	"permissions": [
		"debugger",
		"tabs",
		"tabGroups",
		"alarms",
		"userScripts",
		"cookies",
		"storage"
	],
	"host_permissions": ["<all_urls>"],
	"externally_connectable": {
		"matches": ["http://127.0.0.1/*"]
	},
	"background": {
		"service_worker": "dist/background.js",
		"type": "module"
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "Vitamine",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	}
}
